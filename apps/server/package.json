{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n server,smee -c blue,magenta \"npm:dev:server\" \"npm:dev:smee\"",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev:server": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:smee": "tsx --env-file-if-exists=.env src/smee.ts"
  },
  "dependencies": {
    "@app/core": "*",
    "fastify": "^5.12.8",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "smee-client": "^5.0.0"
  }
}
